#!/usr/bin/env python3
"""WSM Workspace Manager — interactive curses TUI."""

import curses
import os
import re
import subprocess
import sys
from pathlib import Path

CONF_DIR = Path.home() / '.config' / 'workspace'
VERSION = '2.0.0'


def parse_toml(filepath, key):
    """Parse TOML key = "value" from config file."""
    try:
        with open(filepath) as f:
            for line in f:
                m = re.match(rf'^{key}\s*=\s*\"(.+)\"', line)
                if m:
                    return m.group(1)
    except FileNotFoundError:
        pass
    return ''


def is_mounted(path):
    """Check if path is a mountpoint."""
    return subprocess.run(
        ['mountpoint', '-q', path], capture_output=True
    ).returncode == 0


def load_projects():
    """Load all projects with their config and mount status."""
    projects = []
    if not CONF_DIR.exists():
        return projects
    for conf in sorted(CONF_DIR.glob('*.conf')):
        name = conf.stem
        local_mount = parse_toml(conf, 'local_mount')
        remote_path = parse_toml(conf, 'remote_path')
        editor_cmd = parse_toml(conf, 'editor_cmd')
        mounted = bool(local_mount and is_mounted(local_mount))
        projects.append({
            'name': name,
            'remote_path': remote_path,
            'local_mount': local_mount,
            'editor_cmd': editor_cmd,
            'mounted': mounted,
            'conf': str(conf),
        })
    return projects


def wsm_cli(action, project):
    """Call wsm CLI as subprocess."""
    wsm_path = Path(__file__).parent / 'wsm'
    result = subprocess.run(
        [str(wsm_path), action, project],
        capture_output=True, text=True, timeout=30,
    )
    return result.stdout, result.stderr, result.returncode


def create_config_dialog(stdscr):
    """Interactive dialog to create a new project config."""
    h, w = stdscr.getmaxyx()
    win = curses.newwin(12, 60, (h - 12) // 2, (w - 60) // 2)
    win.keypad(True)
    curses.echo()
    curses.curs_set(1)

    fields = [
        ('Project alias:', 30),
        ('Remote path (alias:/path):', 50),
        ('Local mount:', 50),
        ('Editor command:', 20),
    ]
    values = ['', '', '', 'zed']
    current = 0

    while True:
        win.clear()
        win.box()
        win.addstr(0, 2, ' Create Project Config ', curses.A_BOLD)
        win.addstr(10, 2, ' Tab:next  Enter:save  Esc:cancel ')

        for i, (label, maxlen) in enumerate(fields):
            color = curses.A_REVERSE if i == current else curses.A_NORMAL
            win.addstr(2 + i * 2, 3, label)
            display = values[i][:maxlen]
            if i == current:
                display += '_'
            win.addstr(3 + i * 2, 3, f'  {display}', color)

        win.refresh()
        key = win.getch()

        if key == 27:  # Esc
            curses.noecho()
            curses.curs_set(0)
            return None
        elif key == 9:  # Tab
            current = (current + 1) % len(fields)
        elif key == 10:  # Enter
            if not values[0] or not values[0].strip():
                continue
            alias = ''.join(c for c in values[0] if c.isalnum() or c in '_-')
            if not alias:
                continue
            curses.noecho()
            curses.curs_set(0)
            return {
                'alias': alias,
                'remote_path': values[1],
                'local_mount': values[2],
                'editor_cmd': values[3] or 'zed',
            }
        elif key == curses.KEY_BACKSPACE or key == 127:
            values[current] = values[current][:-1]
        elif 32 <= key <= 126:
            values[current] += chr(key)

    curses.noecho()
    curses.curs_set(0)
    return None


def generate_key_dialog(stdscr):
    """Dialog to generate an ED25519 keypair."""
    h, w = stdscr.getmaxyx()
    win = curses.newwin(8, 55, (h - 8) // 2, (w - 55) // 2)
    win.keypad(True)
    curses.echo()
    curses.curs_set(1)

    keyname = ''
    message = ''

    while True:
        win.clear()
        win.box()
        win.addstr(0, 2, ' Generate ED25519 Keypair ', curses.A_BOLD)
        win.addstr(2, 3, 'Key name:')
        win.addstr(3, 3, f'  {keyname}_')
        if message:
            win.addstr(5, 3, message, curses.color_pair(4))
        win.addstr(6, 2, ' Enter:generate  Esc:cancel ')
        win.refresh()

        key = win.getch()

        if key == 27:
            curses.noecho()
            curses.curs_set(0)
            return
        elif key == 10:
            if not keyname.strip():
                message = 'Key name cannot be empty.'
                continue
            clean = Path(keyname).stem
            clean = re.sub(r'\.(key|pub)$', '', clean)
            if not clean:
                message = 'Invalid key name.'
                continue
            private = CONF_DIR / f'{clean}.key'
            public = CONF_DIR / f'{clean}.pub'
            if private.exists():
                message = f'Key {clean}.key already exists!'
                continue
            result = subprocess.run(
                ['ssh-keygen', '-t', 'ed25519', '-f', str(private),
                 '-C', f'wsm-{clean}', '-N', ''],
                capture_output=True, text=True,
            )
            subprocess.run(['mv', f'{private}.pub', str(public)],
                          capture_output=True)
            curses.noecho()
            curses.curs_set(0)
            message = f'Key {clean} generated! Press any key.'
            win.clear()
            win.box()
            win.addstr(0, 2, ' Generate ED25519 Keypair ', curses.A_BOLD)
            win.addstr(3, 3, f'Private: {private}', curses.color_pair(1))
            win.addstr(4, 3, f'Public:  {public}', curses.color_pair(1))
            win.addstr(6, 2, ' Press any key to continue ')
            win.refresh()
            curses.noecho()
            curses.curs_set(0)
            win.getch()
            return
        elif key == curses.KEY_BACKSPACE or key == 127:
            keyname = keyname[:-1]
        elif 32 <= key <= 126:
            keyname += chr(key)


def desktop_snippet(stdscr, project):
    """Show desktop action snippet for a project."""
    h, w = stdscr.getmaxyx()
    lines = [
        f'Actions={project};',
        '',
        f'[Desktop Action {project}]',
        f'Name=Open Remote: {project}',
        f'Exec=bash -c \'source $HOME/.wsm && wsm run {project}\'',
        f'Identifier={project}',
    ]

    win_h = min(len(lines) + 4, h - 2)
    win_w = max(len(max(lines, key=len)) + 4, 50)
    win = curses.newwin(win_h, win_w, (h - win_h) // 2, (w - win_w) // 2)

    win.clear()
    win.box()
    win.addstr(0, 2, ' Desktop Action Snippet ', curses.A_BOLD)
    for i, line in enumerate(lines):
        win.addstr(2 + i, 3, line)
    win.addstr(win_h - 1, 2, ' Press any key to close ')
    win.refresh()
    win.getch()


def draw_help(stdscr):
    """Show full help dialog."""
    h, w = stdscr.getmaxyx()
    help_lines = [
        'WSM Workspace Manager — Keyboard Shortcuts',
        '',
        '  Enter / r        Mount + open in editor',
        '  m                Mount only',
        '  u                Unmount',
        '  c                Create new project config',
        '  d                Show Desktop Action snippet',
        '  k                Generate ED25519 SSH keypair',
        '  h                This help',
        '  q                Quit',
        '  j / ↓            Move down',
        '  k / ↑            Move up',
        '',
        'Configs: ~/.config/workspace/<name>.conf  (TOML format)',
    ]
    win_h = min(len(help_lines) + 2, h - 2)
    win_w = max(len(max(help_lines, key=len)) + 4, 55)
    win = curses.newwin(win_h, win_w, (h - win_h) // 2, (w - win_w) // 2)
    win.clear()
    win.box()
    for i, line in enumerate(help_lines):
        if i == 0:
            win.addstr(i + 1, 3, line, curses.A_BOLD)
        else:
            win.addstr(i + 1, 3, line)
    win.addstr(win_h - 1, 2, ' Press any key to close ')
    win.refresh()
    win.getch()


def main(stdscr):
    curses.curs_set(0)
    stdscr.keypad(True)

    curses.init_pair(1, curses.COLOR_GREEN, -1)   # mounted
    curses.init_pair(2, curses.COLOR_WHITE, -1)    # idle
    curses.init_pair(3, curses.COLOR_BLACK, curses.COLOR_WHITE)  # selection
    curses.init_pair(4, curses.COLOR_YELLOW, -1)   # status
    curses.init_pair(5, curses.COLOR_CYAN, -1)     # header

    idx = 0
    scroll = 0
    message = ''
    needs_refresh = True

    while True:
        if needs_refresh:
            projects = load_projects()
            idx = min(idx, max(0, len(projects) - 1))
            needs_refresh = False

        h, w = stdscr.getmaxyx()
        stdscr.clear()

        # ── Header ──
        header = f' WSM Workspace Manager v{VERSION}  '
        stdscr.addstr(0, 0, header.center(w)[:w], curses.color_pair(5) | curses.A_BOLD)

        # ── Project list ──
        list_start = 2
        visible = h - 5  # space for status bar and messages

        if not projects:
            stdscr.addstr(list_start + 1, 2, 'No projects configured.')
            stdscr.addstr(list_start + 2, 2, f'Create configs in {CONF_DIR}')
            stdscr.addstr(list_start + 3, 2, 'Press [c] to create one.')
        else:
            # Column headers
            stdscr.addstr(list_start, 2, 'PROJECT', curses.A_UNDERLINE)
            stdscr.addstr(list_start, 35, 'STATUS', curses.A_UNDERLINE)
            stdscr.addstr(list_start, 45, 'REMOTE', curses.A_UNDERLINE)

            # Adjust scroll
            if idx < scroll:
                scroll = idx
            elif idx >= scroll + visible:
                scroll = idx - visible + 1

            for i, proj in enumerate(projects[scroll:scroll + visible]):
                y = list_start + 1 + i
                if y >= h - 3:
                    break

                real_idx = scroll + i
                is_sel = real_idx == idx

                # Status
                if proj['mounted']:
                    status = ' MOUNTED'
                    status_color = curses.color_pair(1) | curses.A_BOLD
                else:
                    status = ' idle'
                    status_color = curses.color_pair(2)

                # Line color
                if is_sel:
                    line_color = curses.color_pair(3)
                    stdscr.addstr(y, 0, ' ' * w, line_color)
                else:
                    line_color = curses.A_NORMAL

                prefix = '> ' if is_sel else '  '
                alias = proj['remote_path'].split(':')[0] if proj['remote_path'] else '-'
                alias_short = alias[:15]

                stdscr.addstr(y, 2, f'{prefix}{proj["name"]:<28}', line_color)
                stdscr.addstr(y, 34, status, status_color | (curses.A_REVERSE if is_sel else 0))
                stdscr.addstr(y, 45, alias_short, line_color)

            # Mount info for selected
            if projects:
                sel = projects[idx]
                info_y = h - 3
                if sel['mounted']:
                    info = f' [mounted] {sel["local_mount"]}'
                    stdscr.addstr(info_y, 2, info[:w-4], curses.color_pair(1))
                else:
                    info = ' [not mounted]'
                    stdscr.addstr(info_y, 2, info[:w-4], curses.color_pair(2))

        # ── Status bar ──
        status_bar = (
            f' Enter/r:Run  m:Mount  u:Unmount  c:New  d:Desktop  k:Keys  h:Help  q:Quit  '
        )
        stdscr.addstr(h - 1, 0, status_bar[:w], curses.color_pair(3))

        # ── Message ──
        if message:
            msg_y = h - 2
            stdscr.addstr(msg_y, 2, message[:w-4], curses.color_pair(4))
            message = ''

        stdscr.refresh()

        key = stdscr.getch()

        if key == ord('q'):
            break
        elif key == ord('h'):
            draw_help(stdscr)
            h, w = stdscr.getmaxyx()  # recalc after help
        elif key == ord('j') or key == curses.KEY_DOWN:
            idx = min(idx + 1, len(projects) - 1) if projects else 0
        elif key == ord('k') or key == curses.KEY_UP:
            idx = max(idx - 1, 0)
        elif key == ord('c'):
            data = create_config_dialog(stdscr)
            if data:
                conf_file = CONF_DIR / f'{data["alias"]}.conf'
                CONF_DIR.mkdir(parents=True, exist_ok=True)
                with open(conf_file, 'w') as f:
                    f.write(f'remote_path = "{data["remote_path"]}"\n')
                    f.write(f'local_mount = "{data["local_mount"]}"\n')
                    f.write(f'editor_cmd = "{data["editor_cmd"]}"\n')
                message = f'Config {data["alias"]} saved!'
                needs_refresh = True
            stdscr.clear()
            h, w = stdscr.getmaxyx()
        elif key == ord('k'):
            generate_key_dialog(stdscr)
            stdscr.clear()
            h, w = stdscr.getmaxyx()
        elif not projects:
            continue
        elif key in (ord('r'), 10):  # Enter or r
            sel = projects[idx]
            stdout, stderr, rc = wsm_cli('run', sel['name'])
            if rc == 0:
                message = f'{sel["name"]}: mounted and launched!'
            else:
                message = f'{sel["name"]}: {stderr.strip() or "error"}'
            needs_refresh = True
        elif key == ord('m'):
            sel = projects[idx]
            stdout, stderr, rc = wsm_cli('mount', sel['name'])
            if rc == 0:
                message = f'{sel["name"]}: mounted!'
            else:
                message = f'{sel["name"]}: {stderr.strip() or "error"}'
            needs_refresh = True
        elif key == ord('u'):
            sel = projects[idx]
            stdout, stderr, rc = wsm_cli('unmount', sel['name'])
            message = f'{sel["name"]}: unmounted.'
            needs_refresh = True
        elif key == ord('d'):
            sel = projects[idx]
            desktop_snippet(stdscr, sel['name'])
            stdscr.clear()
            h, w = stdscr.getmaxyx()


if __name__ == '__main__':
    curses.wrapper(main)
