#!/usr/bin/env bash

# Безопасный парсер параметров TOML-конфигурации (Regex вместо инъекционного source)
_wsm_parse_val() {
    local key="$1"
    local file="$2"
    [[ -f "$file" ]] && grep -Po "^${key}\s*=\s*\"\K[^\"]*" "$file" || echo ""
}

# Сетевой резолв и проверка доступности порта SSH вместо уязвимого ping
_wsm_check_net() {
    local alias_name="$1"
    local ssh_info
    ssh_info=$(ssh -G "$alias_name" 2>/dev/null)
    local host
    host=$(echo "$ssh_info" | grep -i "^hostname" | awk '{print $2}')
    local port
    port=$(echo "$ssh_info" | grep -i "^port" | awk '{print $2}')

    if ! nc -z -w 2 "$host" "$port" >/dev/null 2>&1; then
        echo " [ERROR] Host $host:$port is unreachable. Check network or VPN." >&2
        return 1
    fi
    return 0
}

# Главная управляющая функция
wsm() {
    local cmd="${1:-}"
    local project="${2:-}"
    local conf_dir="$HOME/.config/workspace"
    local conf="${conf_dir}/${project}.conf"

    if [[ -z "$cmd" || "$cmd" == "help" || "$cmd" == "-h" ]]; then
        echo "Workspace Manager v2.0.0"
        echo "Usage: wsm [command] [project_name]"
        echo "Commands:"
        echo "  mount, m      Mount remote project directory"
        echo "  unmount, u    Safely unmount project directory"
        echo "  run, r        Verify net, mount project and launch IDE"
        echo "  connect, c    Bypass FUSE: launch native SSH server (Zed or VS Code)"
        return 0
    fi

    if [[ ! -f "$conf" ]]; then
        echo "Error: Project config '$project' not found in $conf_dir" && return 1
    fi

    local remote_path
    local local_mount
    local editor_cmd
    remote_path=$(_wsm_parse_val "remote_path" "$conf")
    local_mount=$(_wsm_parse_val "local_mount" "$conf")
    editor_cmd=$(_wsm_parse_val "editor_cmd" "$conf")

    case "$cmd" in
        mount|m)
            local ssh_alias="${remote_path%%:*}"
            echo -n "Resolving host and checking network..."
            _wsm_check_net "$ssh_alias" || return 1
            echo " [OK]"

            mkdir -p "$local_mount"
            echo "Mounting $ssh_alias to $local_mount..."
            sshfs "$remote_path" "$local_mount" \
                -o cache=yes,cache_stat_timeout=1200,cache_dir_timeout=1200,cache_link_timeout=1200 \
                -o compression=yes,reconnect,ServerAliveInterval=15 \
                -o kernel_cache,noauto_cache
            ;;

        run|r)
            if ! mountpoint -q "$local_mount"; then
                wsm mount "$project" || return 1
            fi

            # Senior Guard Interval: атомарное ожидание готовности VFS Linux
            echo -n "Waiting for VFS layer to stabilize..."
            local timeout=50
            while ! mountpoint -q "$local_mount"; do
                sleep 0.1
                ((timeout--))
                if [ "$timeout" -le 0 ]; then
                    echo " [TIMEOUT FAILED]" && return 1
                fi
            done
            echo " [READY]"

            echo "Launching workspace in background ($editor_cmd)..."
            $editor_cmd "$local_mount" >/dev/null 2>&1 &
            ;;

        unmount|u)
            if mountpoint -q "$local_mount"; then
                echo "Terminating locking file descriptors via fuser..."
                fuser -k -M "$local_mount" >/dev/null 2>&1 || true

                echo "Unmounting $local_mount..."
                if ! umount "$local_mount" 2>/dev/null; then
                    echo "Standard unmount blocked. Applying safe lazy-unmount..."
                    umount -l "$local_mount"
                fi
                echo "Workspace detached successfully."
            else
                echo "Project directory is not mounted."
            fi
            ;;
        connect|c)
            local ssh_alias="${remote_path%%:*}"
            local remote_dir="${remote_path#*:}"

            echo -n "Checking network for native SSH Remoting..."
            _wsm_check_net "$ssh_alias" || return 1
            echo " [OK]"

            if [[ "$editor_cmd" == "code" ]]; then
                echo "Launching VS Code Remote-SSH on $ssh_alias..."
                # Синтаксис VS Code: code --folder-uri=vscode-remote://ssh-remote+<alias><path>
                code --folder-uri="vscode-remote://ssh-remote+${ssh_alias}${remote_dir}" >/dev/null 2>&1 &
            else
                echo "Launching Zed Native SSH Server on $ssh_alias..."
                # Синтаксис Zed: zed ssh://<alias><path>
                zed "ssh://${ssh_alias}${remote_dir}" >/dev/null 2>&1 &
            fi
            ;;
        *)
            echo "Unknown command: $cmd. Use: mount, unmount, run" && return 1
            ;;
    esac
}

# Интерактивный менеджер (вынесен в отдельный модуль)
if [ -f "$HOME/.wsm-manager" ]; then source "$HOME/.wsm-manager"; fi

# Универсальный движок автодополнения (Bash & Zsh-совместимый)
_wsm_complete_logic() {
    local conf_dir="$HOME/.config/workspace"
    if [ -d "$conf_dir" ]; then
        echo "$(find "$conf_dir" -maxdepth 1 -name "*.conf" -exec basename {} .conf \;)"
    fi
}

if [ -n "${BASH_VERSION:-}" ]; then
    _wsm_bash_autocomplete() {
        local cur="${COMP_WORDS[COMP_CWORD]}"
        if [ "$COMP_CWORD" -eq 1 ]; then
            COMPREPLY=($(compgen -W "mount unmount run connect m u r c help" -- "$cur"))
        elif [ "$COMP_CWORD" -eq 2 ]; then
            COMPREPLY=($(compgen -W "$(_wsm_complete_logic)" -- "$cur"))
        fi
    }
    complete -F _wsm_bash_autocomplete wsm
elif [ -n "${ZSH_VERSION:-}" ]; then
    _wsm_zsh_autocomplete() {
        local -a commands projects
        commands=(mount m unmount u run r connect c help)
        projects=(${(f)"$(_wsm_complete_logic)"})
        if (( CURRENT == 2 )); then
            _describe -t commands 'wsm commands' commands
        elif (( CURRENT == 3 )); then
            _describe -t projects 'available projects' projects
        fi
    }
    compdef _wsm_zsh_autocomplete wsm
fi
