#!/usr/bin/env bash

# Интерактивный менеджер конфигураций, ключей и Desktop Actions
wsm-manager() {
    CONFIG_DIR="$HOME/.config/workspace"
    mkdir -p "$CONFIG_DIR"

    show_menu() {
        clear
        echo "========================================="
        echo "       WSM-MANAGER: WORKSPACE MENU       "
        echo "========================================="
        echo "1) Create / Update Project Config (.conf)"
        echo "2) Generate XDG Desktop Action Syntax"
        echo "3) Generate Modern SSH Keypair (ED25519)"
        echo "4) Exit"
        echo "========================================="
        echo -n "Choose an option [1-4]: "
    }

    manage_project() {
        echo "--- Project Configuration Wizard ---"
        read -p "Enter project internal alias (e.g., shop-backend): " alias
        alias=$(echo "$alias" | tr -cd 'a-zA-Z0-9_-')

        if [[ -z "$alias" ]]; then
            echo "Error: Invalid alias." && return 1
        fi

        read -p "Enter Remote Path (e.g., prod-server:/var/www/html): " remote
        read -p "Enter Local Mount Path (e.g., /home/user/mnt/shop): " local_p
        read -p "Enter IDE Command (zed, code, pstorm) [zed]: " editor
        editor="${editor:-zed}"

        local target_file="${CONFIG_DIR}/${alias}.conf"

        cat << EOF > "$target_file"
remote_path = "$remote"
local_mount = "$local_p"
editor_cmd = "$editor"
EOF
        echo "Success! Config saved to: $target_file"
    }

    generate_desktop() {
        echo "--- XDG Desktop Actions Generator ---"
        read -p "Enter project alias to export: " alias
        local target_file="${CONFIG_DIR}/${alias}.conf"

        if [[ ! -f "$target_file" ]]; then
            echo "Error: Config ${alias}.conf does not exist." && return 1
        fi

        echo ""
        echo "Copy and paste this section inside your IDE's ~/.local/share/applications/editor.desktop file:"
        echo "--------------------------------------------------------------------------------"
        echo "Actions=${alias};"
        echo ""
        echo "[Desktop Action ${alias}]"
        echo "Name=Open Remote: ${alias}"
        echo "Exec=bash -c 'source \$HOME/.wsm && wsm run ${alias}'"
        echo "Identifier=${alias}"
        echo "--------------------------------------------------------------------------------"
    }

    generate_keys() {
        echo "--- Crypt-Safe Keypair Generator (ED25519) ---"
        read -p "Enter secure filename for your token: " keyname

        # Санитария ввода: вырезаем расширения, если пользователь ввел их вручную
        local clean_name
        clean_name=$(basename "$keyname" | sed -E 's/\.(key|pub)$//g')

        local private_key="${CONFIG_DIR}/${clean_name}.key"
        local public_key="${CONFIG_DIR}/${clean_name}.pub"

        if [[ -f "$private_key" ]]; then
            echo "Abort: Keypair ${clean_name}.key already exists in storage." && return 1
        fi

        ssh-keygen -t ed25519 -f "$private_key" -C "wsm-${clean_name}"
        mv "${private_key}.pub" "$public_key" 2>/dev/null || true

        echo "Keys generated successfully with strict sanitization:"
        echo " -> Private: $private_key"
        echo " -> Public:  $public_key"
    }

    while true; do
        show_menu
        read -r opt
        case "$opt" in
            1) manage_project ;;
            2) generate_desktop ;;
            3) generate_keys ;;
            4) echo "Exiting WSM Manager." && return 0 ;;
            *) echo "Invalid option. Press Enter to continue..." && read -r ;;
        esac
        echo -n "Press Enter to return to menu..." && read -r
    done
}
